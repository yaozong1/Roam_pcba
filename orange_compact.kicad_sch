	)
	(text "CD4060 is a 14 bit counter with internal oscillator\nOscillator setup with C and R as below:\n\nf = 1 / ( 2.5 x R x C)\n\nf = 1 / (2.5 * 220k * 1u) = 1.8Hz\n1/1.8Hz = 0.55 sec\n\n0b10000000000000 = 8192\n0.55sec * 8192 = ~75min\n\nQ13 is turned HIGH after around 75min\ntoggle WDI will reset counter\nPower cycle will reset counter\n"
		(exclude_from_sim no)
		(at 272.415 124.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2b283ffe-bc5a-45dd-bc47-aa2696b95b05")
	)
	(text "VBAT_BB -> BaseBand 0.3A\nVBAT_RF -> RF POWER 1.3A\n\nTotal 1.6A\n"
