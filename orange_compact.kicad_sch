	(text "Vstart = 10.5v\n*Vstop  = 9V\n\nRent = (10.5V- 9V)/ 3.6uA = ~416.6K, we take 412K\nVhys= 412K*3.6uA = 1.48v\nSo Vstop = 10.5v-1.48v = 9.02V\n\nRenb = Ven/((Vstart-Ven)/Rent + Ien) = 51k"
		(exclude_from_sim no)
		(at 78.994 107.95 0)
		(effects
