
(rules PCB roam
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 12)
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.8)
      (against_preferred_direction_trace_costs 3.5)
    )
    (layer_rule In1.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.6)
    )
    (layer_rule In2.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.7)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.8)
      (against_preferred_direction_trace_costs 2.4)
    )
  )
  (rule
    (width 250.0)
    (clear 200.0)
    (clear 125.0 (type smd_to_turn_gap))
    (clear 50.0 (type smd-smd))
  )
  (padstack "Via[0-3]_500:300_um"
    (shape
      (circle F.Cu 500.0 0.0 0.0)
    )
    (shape
      (circle In1.Cu 500.0 0.0 0.0)
    )
    (shape
      (circle In2.Cu 500.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 500.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-3]_800:300_um"
    (shape
      (circle F.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle In1.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle In2.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 800.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-3]_500:300_um" "Via[0-3]_500:300_um" default
  )
  (via 
    "Via[0-3]_800:300_um" "Via[0-3]_800:300_um" default
  )
  (via 
    "Via[0-3]_500:300_um-kicad_default" "Via[0-3]_500:300_um" "kicad_default"
  )
  (via 
    "Via[0-3]_800:300_um-kicad_default" "Via[0-3]_800:300_um" "kicad_default"
  )
  (via_rule
    default "Via[0-3]_500:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-3]_500:300_um-kicad_default"
  )
  (class default
    GND 3V3 "3V3_ANT" "/SIM_VDD" "4V2_MODEM" "/GNSS_ANT" "Net-(C10-Pad1)" "Net-(C11-Pad2)"
    "Net-(C12-Pad2)" "/RF_ANT" 3.3V 1V8 "unconnected-(D1-Pad1)" "/SIM_CHIP_CLK" "/SIM_CHIP_DATA" "/SIM_CHIP_RST"
    "Net-(D3-Pad1)" "/NRF_LED" "Net-(D4-Pad1)" "/CONN_LED" "Net-(D5-Pad1)" "/AUX_LED" "Net-(D6-Pad1)" 4V2
    /SWDIO /SWDCLK "Net-(L1-Pad1)" "Net-(Q1-Pad1)" "Net-(Q2-Pad1)" "/SIM_DATA" "/SIM_CLK" "/SIM_RST"
    /PWRKEY /NRESET "/STATUS_LED_3V3" "/MODEM_TX_1V8" "/MODEM_RX_1V8" "/STATUS_LED" "/NET_LED" "/I2C1_SDA"
    "/I2C1_SCL" "/WDT_FEED" "/FLASH_CS" "/FLASH_MISO" "/FLASH_MISO2" "/FLASH_MOSI" "/FLASH_SCK" "/FLASH_MISO3"
    "/MODEM_DTR_1V8" "/MODEM_RI_1V8" "/DCD_1V8" "/CTS_1V8" "/RTS_1V8" "/MODEM_RX_3V3" "/MODEM_TX_3V3" "/RTS_3V3"
    "/CTS_3V3" "/DCD_3V3" "/MODEM_RI_3V3" "/MODEM_DTR_3V3" "unconnected-(J1-PadC6)" /P1.01 /~{PE} /P0.12
    "/P0.05_AIN3" /~{CE} "unconnected-(U2-Pad54)" "/CAN_CS" "/ACC_INT" "/CAN_MISO" "/I2C2_SDA" "unconnected-(U2-Pad34)"
    "/P0.28_AIN4" "/P0.02_AIN0" "/P0.03_AIN1" "/GPS_ANT_EN" "unconnected-(U2-Pad35)" "/I2C2_SCL" "/CAN_MOSI" "/CAN_SCK"
    "unconnected-(U2-Pad32)" "unconnected-(U2-Pad31)" "unconnected-(U2-Pad30)" "/CAN_INT" "/P0.04_AIN2" "/SERIAL_RX" "/SERIAL_TX" /IBL
    /EBL "/P0.29_AIN5" /P1.13 "unconnected-(U3-Pad68)" "unconnected-(U3-Pad67)" "unconnected-(U3-Pad51)" "unconnected-(U3-Pad50)" "unconnected-(U3-Pad49)"
    "unconnected-(U3-Pad48)" "unconnected-(U3-Pad47)" "unconnected-(U3-Pad44)" "unconnected-(U3-Pad43)" "unconnected-(U3-Pad42)" "unconnected-(U3-Pad41)" "unconnected-(U3-Pad40)" "unconnected-(U3-Pad38)"
    "unconnected-(U3-Pad37)" "unconnected-(U3-Pad36)" "unconnected-(U3-Pad35)" "unconnected-(U3-Pad34)" "/USB_D-" "/USB_D+" "unconnected-(U3-Pad26)" "unconnected-(U3-Pad25)"
    "/USB_VBUS" "unconnected-(U3-Pad22)" "unconnected-(U3-Pad21)" "unconnected-(U3-Pad20)" "unconnected-(U3-Pad19)" "unconnected-(U3-Pad14)" "unconnected-(U3-Pad13)" "unconnected-(U3-Pad12)"
    "unconnected-(U3-Pad11)" "unconnected-(U3-Pad6)" 12V "Net-(C21-Pad1)" /COIL "Net-(C24-Pad2)" "Net-(C25-Pad1)" "4V_DCDC"
    VBAT 4V0 "3V3_ALWAYS_ON" "/CAN_OSC1" "3V3_CAN" "/CAN_OSC2" "3V3_SENS" "Net-(F1-Pad2)"
    /TXCAN /RXCAN "/NMEA_NET_L" "/NMEA_NET_H" /VUSB "Net-(JP2-Pad1)" "Net-(JP2-Pad2)" "Net-(L5-Pad1)"
    "Net-(R17-Pad1)" "/BAT_TEMP" "Net-(R33-Pad2)" "Net-(R36-Pad2)" /SDA /SCL "Net-(R40-Pad2)" "unconnected-(U8-Pad13)"
    "unconnected-(U10-Pad3)" "unconnected-(U11-Pad11)" "unconnected-(U11-Pad12)" "unconnected-(U13-Pad11)" "unconnected-(U13-Pad3)" "/~{P_EN}" /P0.00 "unconnected-(Z1-Pad5)"
    "unconnected-(Z1-Pad4)" "unconnected-(Z1-Pad6)" "Net-(R18-Pad1)" "Net-(R48-Pad1)" "unconnected-(U3-Pad23)" "5V_BUCK" "5V_BOOST" "unconnected-(U7-Pad4)"
    "Net-(U7-Pad5)" 5V0 "unconnected-(U9-Pad4)" "unconnected-(U9-Pad5)" "unconnected-(U11-Pad3)" "unconnected-(U11-Pad4)" "unconnected-(U11-Pad5)" "unconnected-(U11-Pad6)"
    "unconnected-(U11-Pad7)" "unconnected-(U11-Pad10)" "unconnected-(U11-Pad15)" "unconnected-(U16-Pad3)" "unconnected-(U16-Pad5)" "unconnected-(U16-Pad8)"
    (clearance_class default)
    (via_rule default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu In1.Cu In2.Cu B.Cu)
    )
  )
  (class "kicad_default"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu In1.Cu In2.Cu B.Cu)
    )
  )
)